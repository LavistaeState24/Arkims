{
  "scripts": {
    "dev": "concurrently -n css,web -c green,cyan \"npm:css\" \"npm:web\"",
    "web": "vite",
    "css": "tailwindcss -i ./css/input.css -o ./css/output.css --watch",
    "css:build": "tailwindcss -i ./css/input.css -o ./css/output.css --minify",
    "build": "npm run css:build && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.5",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.2"
  }
}
